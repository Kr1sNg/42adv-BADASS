# =====================================================================
# routeur-tat-nguy - Part 1 
# =====================================================================
# Network configuration (GNS3 "Edit config")
# Applied at boot like the host's file. The routing daemons
# (zebra, bgpd, ospfd, isisd) are started by the FRR image itself,
# not by this file.

# Bring eth1 up automatically at boot
auto eth1

# eth1 = the port cabled to host_tat-nguy-1 in the GNS3 topology
iface eth1 inet static
    # Router address in the same subnet as the host
    address 192.168.0.1
    # /24 mask: same network as the host (192.168.0.0/24)
    netmask 255.255.255.0