# =====================================================================
# routeur-tat-nguy-1 - Part 2 - STATIC (unicast) VXLAN
# GNS3 "Edit config" (/etc/network/interfaces, applied at every boot)
# ---------------------------------------------------------------------
# eth0 : underlay, cabled to Switch-tat-nguy, IP 10.1.1.1/24
# eth1 : host side, NO IP (it is only a port of bridge br0)
# vxlan10 : VTEP, VNI 10, UDP 4789, fixed remote peer 10.1.1.2
# br0  : Linux bridge (software switch) joining eth1 and vxlan10
#
# Static mode: BUM traffic (broadcast, e.g. ARP) is sent unicast to the
# hardcoded remote VTEP. Simple, but every peer must be listed by hand.
# =====================================================================

# Host-facing port: no address, just bring it up
auto eth1
iface eth1 inet manual
    up ip link set eth1 up

# Underlay interface + VXLAN + bridge
auto eth0
iface eth0 inet static
    address 10.1.1.1
    netmask 255.255.255.0
    # VXLAN interface: VNI 10, point-to-point tunnel to the other VTEP.
    # dstport 4789 = IANA VXLAN port (Linux default would be 8472).
    up ip link add name vxlan10 type vxlan id 10 dev eth0 local 10.1.1.1 remote 10.1.1.2 dstport 4789
    up ip link set vxlan10 up
    # Bridge br0: frames from the host enter the tunnel and vice versa.
    # The bridge learns MAC addresses (see: brctl showmacs br0).
    up brctl addbr br0
    up brctl addif br0 eth1
    up brctl addif br0 vxlan10
    up ip link set br0 up
