# =====================================================================
# routeur-tat-nguy-2 - Part 2 - STATIC (unicast) VXLAN
# ---------------------------------------------------------------------
# eth0    : UNDERLAY, cabled to Switch-tat-nguy, IP 10.1.1.2/24.
#           The "real" network used to carry the tunnel.
# eth1    : cabled to host-tat-nguy-2. NO IP: it is only a port of
#           the bridge br0 (Layer 2, like a switch port).
# vxlan10 : the VTEP. Wraps host Ethernet frames in UDP/IP packets
#           (VNI 10, UDP 4789) and unwraps packets from the other VTEP.
# br0     : Linux bridge = software switch joining eth1 and vxlan10.
#
# STATIC mode: the remote VTEP (10.1.1.1) is written by hand. Broadcast
# traffic (e.g. ARP "who has 30.1.1.x?") is sent unicast to that peer.
# Simple, but every peer must be listed manually: does not scale.
#
# Result: the router acts like one half of a switch stretched over
# the underlay network. VXLAN adds ~50 bytes of headers, so vxlan10
# gets MTU 1450 (1500 - 50) automatically.
# =====================================================================

# Underlay: give eth0 an IP to reach the other VTEP
ip addr add 10.1.1.2/24 dev eth0
ip link set eth0 up

# VXLAN interface, VNI 10, unicast tunnel to the remote VTEP
ip link add name vxlan10 type vxlan id 10 dev eth0 local 10.1.1.2 remote 10.1.1.1 dstport 4789
ip link set vxlan10 up

# Bridge joining host-facing port and tunnel
ip link add br0 type bridge
ip link set eth1 master br0
ip link set vxlan10 master br0
ip link set br0 up
ip link set eth1 up