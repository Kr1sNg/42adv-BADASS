# =====================================================================
# host_tat-nguy-1 - Part 2
# ---------------------------------------------------------------------
# GNS3 writes this file to /etc/network/interfaces inside the container
# and applies it at every boot with "ifup -a".
# The Docker image itself contains NO IP address (subject rule).
#
# This host knows NOTHING about VXLAN: it just sees a normal Ethernet
# network. Both hosts are in 30.1.1.0/24 (the OVERLAY network) and talk
# at Layer 2, as if plugged into the same switch. The routers carry
# their frames through the VXLAN tunnel transparently.
# =====================================================================

# Bring eth0 up automatically at boot
auto eth0
# eth0 = the port cabled to routeur_tat-nguy-1 eth1 in GNS3
# IPv4, fixed (static) address, no DHCP
iface eth0 inet static
    # Host address in the overlay network 30.1.1.0/24
    address 30.1.1.1
    # /24 mask: the other host (30.1.1.2) is in the same network,
    # so it is reached directly (ARP + Ethernet), no gateway needed
    netmask 255.255.255.0
